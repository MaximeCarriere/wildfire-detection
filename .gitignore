# Datasets and weights are never committed — data/README.md records how to restore them.
data/*.zip
data/dfire/
data/flame/
data/flame2/
data/boreal/
data/calib/
# YOLOv5-format path lists, regenerated per machine by lib/finetune.py. Absolute
# paths, machine-specific — never commit them next to the frozen, checksummed
# relative-path splits they are derived from.
data/splits/yolo/
*.pt
# Same rule for the exported forms: an .onnx or .tflite is a weight file that
# happens to be portable, and both are regenerated from the checkpoint.
*.tflite
*.onnx
*.engine
*.engine.calib

# Per-run measurements ARE committed — they are the evidence behind every claim,
# they are small (a few KB each), and analysis/make_figures.py regenerates every
# figure from them. Figures are committed too so the READMEs render on GitHub;
# they remain generated-only (never hand-edited).
results/raw/*
!results/raw/*.json
!results/raw/.gitkeep
results/figures/*
!results/figures/*.png
!results/figures/.gitkeep

# Demo captures (large video) — the 20 s final clip is committed deliberately, nothing else.
demos/frames/
demos/*.mp4
!demos/final_*.mp4

# Ultralytics training scratch
runs/
*.cache

# Python
__pycache__/
*.py[cod]
.venv/
fire-venv/
.DS_Store

# XP15: generated board artifacts. The npz frame sets and the multi-megabyte C
# headers are reproducible from export_frames.py and make_headers.py, and the
# headers in particular are 2 MB of hex that would bloat every clone.
experiments/xp15_esp32_gate/board_data/
experiments/xp15_esp32_gate/firmware/model_data.h
experiments/xp15_esp32_gate/firmware/frames_data.h
